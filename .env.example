# Configuration Google Earth Engine pour le moteur NRT (Near Real-Time)
# 
# Copiez ce fichier en ".env" et remplissez avec vos vraies valeurs
#
# Exemple de commande Windows:
#   copy .env.example .env
#
# Exemple de commande Linux/Mac:
#   cp .env.example .env

# =============================================================================
# CONFIGURATION GOOGLE EARTH ENGINE
# =============================================================================

# Votre ID de projet Google Earth Engine
# Format: "ee-username" ou "projects/xxxxx"
# 
# Pour le trouver:
#   1. Allez sur https://code.earthengine.google.com/
#   2. Le nom du projet s'affiche en haut à droite
#
GEE_PROJECT_ID=ee-houdbousse96

# Chemin racine de vos assets Earth Engine
# C'est là où vous avez exporté vos indicateurs SDG depuis Colab
#
# Format: "projects/PROJECT_ID/assets/FOLDER_NAME"
#
GEE_ASSET_ROOT=projects/ee-houdbousse96/assets/ldn

# =============================================================================
# AUTHENTIFICATION (Optionnel - pour automatisation)
# =============================================================================

# Si vous utilisez un compte de service pour l'automatisation
# (pas nécessaire pour l'utilisation interactive)
#
# GEE_SERVICE_ACCOUNT=your-service-account@project.iam.gserviceaccount.com
# GEE_SERVICE_ACCOUNT_KEY=/path/to/key.json

# =============================================================================
# PARAMÈTRES DE REPORTING (Optionnel)
# =============================================================================

# Période de référence et de suivi
# (déjà définis dans refresh_sdg_tiles.py, mais peuvent être surchargés ici)
#
# REPORT_START=2016
# REPORT_END=2025
